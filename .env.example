# Chronicle Shorts settings (Chromebook edition). Every line is optional.
# Edit in the Linux Terminal with:  nano .env   (save: Ctrl+O, Enter; quit: Ctrl+X)
# Restart the app after changes (Stop Chronicle Shorts, then Chronicle Shorts).

# --- AI story analysis (recommended) -----------------------------------------
# Paste your Anthropic API key to let Claude read each documentary and choose,
# rank and title the moments. Without a key the free offline scorer is used.
# Get a key at https://console.anthropic.com  (pay-as-you-go, no subscription)
ANTHROPIC_API_KEY=
# This is the default model; you can also pick one per video in the studio.
# claude-opus-5-5 = best judgement   claude-sonnet-5-5 = half the price   claude-haiku-5-5 = cheapest
# The studio shows what each run actually cost.
CH_CLAUDE_MODEL=claude-opus-5-5
# Long videos (stream VODs) are read in parts of this many minutes.
CH_CLAUDE_CHUNK_MINUTES=60

# --- Speech recognition (free, runs on the Chromebook) -------------------------
# base  = good for most Chromebooks (default)
# small = more accurate names, about 3x slower - use on a fast Chromebook (i5/i7, 8 GB+)
# tiny  = fastest, least accurate - for very low-end Chromebooks
CH_WHISPER_MODEL=base
CH_WHISPER_LANGUAGE=en

# --- Rendering ----------------------------------------------------------------
# veryfast = quick on Chromebooks (default). medium = slightly smaller files, ~3x slower.
CH_X264_PRESET=veryfast

# --- Branding (optional) ------------------------------------------------------
# Leave empty for no branding. CH_WATERMARK puts small text at the top of
# documentary-mode clips (never on stream clips). CH_EXTRA_HASHTAGS are added to every clip.
CH_WATERMARK=
CH_EXTRA_HASHTAGS=

# --- Streams ------------------------------------------------------------------
# Playback speed for stream/podcast clips (1.0 = natural speed).
CH_STREAM_SPEED=1.0

# --- How many shorts --------------------------------------------------------------
# Automatic mode keeps every moment that clears the quality bar, up to this many per video.
CH_CLIP_CAP=20
# Claude's 0-100 score a moment needs to be kept (higher = fewer, stronger shorts).
CH_QUALITY_BAR=70

# --- Instagram (optional) ----------------------------------------------------------
# Easiest: click "Connect Instagram" in the studio. Or put the login here.
# IG_ACCESS_TOKEN=
# IG_USER_ID=

# --- Advanced -------------------------------------------------------------------
# CH_PORT=8765
# CH_MAX_UPLOAD_GB=20
# CH_MAX_SOURCE_MINUTES=480
